<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="#FF000000">

    <!-- Lapisan cahaya ambien di latar; warnanya mengikuti ubin yang sedang difokuskan dan muncul dengan animasi alpha. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" 
        android:visibility="gone" />

    <!--Rak atas: nama tempat, negara/provinsi, dan deskripsinya. Posisinya diatur di kode tepat di atas dock
        (setY = heroBottom - tinggi view). Lebar nama dan deskripsi dibatasi di kode ke sebagian ruang di antara
        padding samping, dan deskripsi maksimal dua baris.-->
    <LinearLayout
        android:id="@+id/heroShelf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="55dp"
        android:orientation="vertical"
        android:alpha="0">

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="36sp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 600"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.75"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="5"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Negara/provinsi tepat di bawah nama, deskripsi menyusul di bawahnya. Keduanya disembunyikan bila gambar tidak punya keterangan. -->
        <TextView
            android:id="@+id/heroWhere"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 600"
            android:letterSpacing="0.18"
            android:textAllCaps="true"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:singleLine="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/heroDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 400"
            android:lineSpacingExtra="2dp"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Blok kiri atas: jam besar, dengan blok hari/tanggal di sebelah kanannya. -->
            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="hh.mm"
                    android:format24Hour="HH.mm"
                    android:textColor="#FFFFFFFF"
                    android:textSize="48sp"
                    android:textStyle="bold" 
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 800"
                    android:letterSpacing="-0.01"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:includeFontPadding="false" />

                <!-- Tata letak 1:2: jam di kiri, dua baris bertumpuk di kanan (atas: nama hari, bawah: tanggal lengkap). -->
                <LinearLayout
                    android:id="@+id/dateBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!--  Atas: nama hari dalam bahasa Indonesia (mis. Senin / Jumat), diisi oleh updateDateAndPeriod().  -->
                    <TextView 
                        android:id="@+id/ampm" 
                        android:layout_width="wrap_content" 
                        android:layout_height="wrap_content" 
                        android:includeFontPadding="false" 
                        android:textColor="#FFFFFFFF" 
                        android:textSize="17sp" 
                        android:fontFamily="@font/inter" 
                        android:fontVariationSettings="'wght' 600" 
                        android:letterSpacing="0.06" 
                        android:shadowColor="#80000000" 
                        android:shadowDx="0" 
                        android:shadowDy="1" 
                        android:shadowRadius="3" 
                        android:textAllCaps="false"/>

                    <!-- Bawah: tanggal lengkap (mis. 2 November 2026), dan di belakangnya tanggal Hijriah
                         (mis. 12 Jumadil-Awal 1448 H). Keduanya diisi updateDateAndPeriod() dan bergantian;
                         keduanya selalu terlihat supaya lebar blok tidak berubah saat animasi, yang tidak
                         giliran hanya transparan. -->
                    <FrameLayout
                        android:id="@+id/dateSlot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <TextView
                            android:id="@+id/date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:textColor="#E6FFFFFF"
                            android:textSize="17sp"
                            android:fontFamily="@font/inter"
                            android:fontVariationSettings="'wght' 600"
                            android:letterSpacing="0.06"
                            android:shadowColor="#80000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            android:textAllCaps="false"/>

                        <!-- Tanggal Hijriah, ditulis "12 Jumadil-Awal 1448 H" (HijriCalendar). -->
                        <TextView
                            android:id="@+id/dateHijri"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0"
                            android:includeFontPadding="false"
                            android:textColor="#E6FFFFFF"
                            android:textSize="17sp"
                            android:fontFamily="@font/inter"
                            android:fontVariationSettings="'wght' 600"
                            android:letterSpacing="0.06"
                            android:shadowColor="#80000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="3"
                            android:textAllCaps="false"/>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Pil cuaca & kualitas udara (AQI) di bawah blok jam; dapat difokuskan dan diklik untuk membuka WeatherActivity. -->
            <TextView
                android:id="@+id/weatherAirQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/leftBlock"
                android:layout_alignParentStart="true"
                android:layout_marginTop="8dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/weather_pill_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:includeFontPadding="false"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 500"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:singleLine="true" />

            <!-- Kartu Now Playing: album art, info lagu, dan kontrol pemutaran; tersembunyi selama tidak ada media yang diputar. -->
            <LinearLayout
                android:id="@+id/nowPlayingCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:layout_below="@id/weatherAirQuality"
                android:layout_alignParentStart="true"
                android:layout_marginTop="12dp"
                android:focusable="false"
                android:visibility="gone"
                android:background="@drawable/glass_panel"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/cardAlbumArt"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_media_app_pill"
                    android:src="@drawable/ic_music"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusRight="@+id/cardTrackInfo" />

                <LinearLayout
                    android:id="@+id/cardTrackInfo"
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_track_info_selector"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@+id/cardAlbumArt"
                    android:nextFocusRight="@+id/btnInlinePrev">

                    <TextView
                        android:id="@+id/cardSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sedang diputar • SPOTIFY"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.04"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/cardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Judul Lagu"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="@font/inter"
                        android:fontVariationSettings="'wght' 600"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever" />
                </LinearLayout>

                <!-- Kontrol pemutaran inline: Sebelumnya, Putar/Jeda, Berikutnya, dan Tutup (tombol bulat dengan background bg_np_round_btn). -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnInlinePrev"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_skip_previous"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/cardTrackInfo"
                        android:nextFocusRight="@+id/btnInlinePlayPause" />

                    <ImageView
                        android:id="@+id/btnInlinePlayPause"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_pause"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/btnInlinePrev"
                        android:nextFocusRight="@+id/btnInlineNext" />

                    <ImageView
                        android:id="@+id/btnInlineNext"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_skip_next"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/btnInlinePlayPause"
                        android:nextFocusRight="@+id/btnInlineClose" />

                    <ImageView
                        android:id="@+id/btnInlineClose"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:padding="9dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_close"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/btnInlineNext" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bilah Tombol Atas: Input, Wi-Fi, Asisten, Kotak Fitur, dan Pengaturan, berjajar di kanan atas;
                 tingginya disamakan dengan blok jam/tanggal. -->
            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignTop="@id/leftBlock"
                android:layout_alignBottom="@id/leftBlock"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopMenuButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopMenuButton"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi" />

                <TextView
                    android:id="@+id/btnAssistant"
                    style="@style/TopMenuButton"
                    android:layout_width="42dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:drawablePadding="0dp"
                    android:contentDescription="Google Assistant"
                    android:drawableStart="@drawable/ic_mic" />

                <TextView
                    android:id="@+id/btnCandyBox"
                    style="@style/TopMenuButton"
                    android:layout_width="42dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:drawablePadding="0dp"
                    android:contentDescription="Candy Box"
                    android:drawableStart="@drawable/ic_candy_box" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopMenuButton"
                    android:layout_width="42dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="0dp"
                    android:drawablePadding="0dp"
                    android:contentDescription="@string/settings"
                    android:drawableStart="@drawable/ic_settings" />
            </LinearLayout>

        </RelativeLayout>

        <!-- Pembungkus grid: tepi atasnya memudar ke transparan saat baris tergulir ke bawah bilah atas. Pembungkus dan grid tidak memotong anak, sehingga ubin yang diperbesar tetap terlihat meluber dari selnya. -->
        <com.gathin.tvhome.FadeTopFrame
            android:id="@+id/gridWrap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </com.gathin.tvhome.FadeTopFrame>
    </LinearLayout>

    <!-- Sorotan kaca yang bergerak dengan animasi pegas ke ubin yang sedang difokuskan. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
